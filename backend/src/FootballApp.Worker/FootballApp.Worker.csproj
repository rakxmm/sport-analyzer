<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same ID as FootballApp.Api, so R2 keys set once with `dotnet user-secrets` reach both. -->
    <UserSecretsId>338e8edf-4cc5-462a-93dd-60840b72a39e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FootballApp.Application\FootballApp.Application.csproj" />
    <ProjectReference Include="..\FootballApp.Infrastructure\FootballApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
